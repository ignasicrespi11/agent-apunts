# Copy to .env and fill in. .env is gitignored and Claude Code is denied from reading it.
ANTHROPIC_API_KEY=
QDRANT_URL=http://localhost:6333
# Ollama serves the embedding model (bge-m3) and, from week 4, the local LLM.
OLLAMA_URL=http://localhost:11434

# Where the private PDFs live on THIS machine (they are never in git).
# Empty = defaults ./apunts and ./testing/apunts_testing
# Windows: C:\Users\<you>\OneDrive - UAB\_UNI\apunts_testing
# Omarchy: /home/<you>/OneDrive/_UNI/apunts_testing
APUNTS_DIR=
TESTING_DIR=
